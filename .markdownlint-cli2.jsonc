{
  // Generated changelogs repeat "### Minor Changes" and "### Patch Changes"
  // under every version heading. Those are not real duplicates: they live
  // under different parents, and relying on an inline disable comment inside
  // a changeset body breaks whenever Changesets regenerates the file.
  "config": {
    "MD024": { "siblings_only": true },
    // READMEs size their images with an <img width> tag; Markdown image
    // syntax cannot express a display size.
    "MD033": { "allowed_elements": ["img"] },
  },
}
